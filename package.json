{
  "name": "@beardon/magpie-node",
  "version": "0.1.7",
  "type": "commonjs",
  "description": "Commonly-used JavaScript libraries for Node.js applications",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./chalk": "./src/chalk/index.js",
    "./chalk/*": "./src/chalk/*.js",
    "./color": "./src/color/index.js",
    "./color/*": "./src/color/*.js",
    "./console": "./src/console/index.js",
    "./console/*": "./src/console/*.js",
    "./date": "./src/date/index.js",
    "./date/*": "./src/date/*.js",
    "./enums": "./src/enums.js",
    "./math": "./src/math/index.js",
    "./math/*": "./src/math/*.js",
    "./sequelize": "./src/sequelize/index.js",
    "./sequelize/*": "./src/sequelize/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beardon/magpie-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "author": "Aaron Bean <aaron.bean@beardon.com> (https://beardon.com)",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/beardon/magpie-node/issues"
  },
  "homepage": "https://github.com/beardon/magpie-node#readme",
  "dependencies": {
    "chalk": "4.x",
    "change-case": "4.x",
    "lodash": "4.x",
    "luxon": "3.x",
    "pluralize": "8.x"
  },
  "peerDependencies": {
    "config": "3.x - 5.x",
    "sequelize": "6.x",
    "sequelize-simple-cache": "1.x",
    "zeddemore-logger": "2.x"
  },
  "peerDependenciesMeta": {
    "sequelize": {
      "optional": true
    },
    "sequelize-simple-cache": {
      "optional": true
    }
  }
}
